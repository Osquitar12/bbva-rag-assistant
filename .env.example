# ===================== LLM =====================
# Proveedor: groq (recomendado, gratis, sin descargas) | ollama (100% local)
LLM_PROVIDER=groq
# Crea tu API key gratis en https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_REWRITE_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500
# Solo aplica a modelos gpt-oss (low | medium | high)
LLM_REASONING_EFFORT=low
# Para Ollama (perfil docker "ollama"): LLM_PROVIDER=ollama, LLM_MODEL=qwen2.5:3b, LLM_REWRITE_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434/v1

# ===================== Conversación =====================
# Número de mensajes previos de la sesión que se envían como contexto
HISTORY_WINDOW_N=6
# Reformula preguntas de seguimiento ("¿y cuánto cuesta?") usando el historial
QUERY_REWRITE_ENABLED=true

# ===================== Scraping =====================
SCRAPE_MAX_PAGES=300
SCRAPE_CONCURRENCY=4
SCRAPE_DELAY_SECONDS=0.5
# Substrings separados por coma. Vacío = todo el sitemap
SCRAPE_INCLUDE_PATTERNS=
SCRAPE_EXCLUDE_PATTERNS=/investor-relations/,/herramientas/,/landing/formulario
# true = vuelve a scrapear aunque ya existan datos limpios
SCRAPE_FORCE=false

# ===================== Chunking / Embeddings =====================
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
QDRANT_COLLECTION=bbva_co
# true = borra y recrea la colección
REINDEX=false

# ===================== Recuperación / Reranker =====================
RETRIEVAL_TOP_K=20
RERANK_TOP_N=4
# El reranker multilingüe pesa ~1.1 GB. Pon false si tienes poco disco.
RERANKER_ENABLED=true
RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Umbral opcional de score mínimo por chunk (vacío = sin umbral)
# MIN_RELEVANCE_SCORE=

# ===================== Analítica =====================
# Minutos que tomaría encontrar manualmente una respuesta en el sitio
MINUTES_SAVED_PER_ANSWER=4

LOG_LEVEL=INFO
